    },
    {
      "id": "05a",
      "scene_id": "05-basket-size",
      "text": "一般的なバスケットは14人から20人ほど。少人数や長時間のプランほど、ゆとりは増えます。",
      "subtitle": "一般的なバスケットは14人から20人ほど。少人数や長時間のプランほど、ゆとりは増えます。",
      "highlight": [],
      "hold_after": 0.12,
