      "ffprobe_duration": 6.325333,
      "start": 31.330666666666666,
      "end": 37.656,
      "audio_duration": 6.325333333333333
    },
    {
      "id": "07a",
      "scene_id": "07-checklist",
      "text": "予約では、認可事業者か、飛行時間と人数、送迎、保険、欠航時の振替と返金条件を確認しましょう。",
      "subtitle": "予約では、認可事業者か、飛行時間と人数、送迎、保険、欠航時の振替と返金条件を確認しましょう。",
      "highlight": [],
      "hold_after": 0.12,
