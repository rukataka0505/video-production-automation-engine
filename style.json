{
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "default_duration_seconds": 75,
    "default_news_window_days": 7,
    "max_still_seconds": 7.0,
    "target_visual_change_seconds": 4.5,
    "background_color": "#07111F"
  },
  "subtitles": {
    "font": "Yu Gothic UI Semibold",
    "size": 60,
    "primary_color": "#FFFFFF",
    "emphasis_color": "#FFF36A",
    "outline_color": "#168C4A",
    "border_style": 3,
    "outline": 12,
    "shadow": 3,
    "margin_vertical": 60,
    "max_chars_per_line": 21,
    "max_lines": 2,
    "dialogue": {
      "mode_name": "掛け合いの動画",
      "speaker_labels": true,
      "speaker_styles": {
        "zundamon": {
          "text_color": "#66E07A",
          "emphasis_color": "#C8FFD0",
          "panel_color": "#146B32"
        },
        "metan": {
          "text_color": "#C995FF",
          "emphasis_color": "#F0D9FF",
          "panel_color": "#5B287D"
        }
      }
    }
  },
  "voicevox": {
    "speaker": 3,
    "speaker_label": "ずんだもん / ノーマル",
    "speedScale": 1.08,
    "pitchScale": 0.0,
    "intonationScale": 1.1,
    "volumeScale": 1.0,
    "prePhonemeLength": 0.08,
    "postPhonemeLength": 0.12,
    "outputSamplingRate": 48000,
    "outputStereo": false,
    "speakers": {
      "zundamon": {
        "speaker": 3,
        "label": "ずんだもん / ノーマル"
      },
      "metan": {
        "speaker": 2,
        "label": "四国めたん / ノーマル"
      }
    }
  },
  "audio": {
    "narration_lufs": -16,
    "final_lufs": -14,
    "true_peak_db": -1.5,
    "bgm_volume": 0.08,
    "default_segment_gap_seconds": 0.12
  },
  "editing": {
    "default_transition": "cut",
    "transition_note": "内容上必要な場合だけ短いディゾルブを使う",
    "still_motion": {
      "default": "none",
      "engine": "mlt_qtblend_transform",
      "easing": "sinusoidal_in_out",
      "max_zoom_percent": 3.0,
      "max_pan_percent": 1.0
    }
  },
  "delivery": {
    "filename_strategy": "project_title",
    "preserve_resolution": true,
    "require_descriptive_filename": true
  },
  "youtube": {
    "auto_upload": true,
    "privacy_status": "private",
    "category_id": "22",
    "made_for_kids": false,
    "wait_for_processing": true
  }
}
